# Optional public JSON endpoint. No secret credentials should be exposed in a VITE_ variable.
VITE_DASHBOARD_DATA_URL=

# Optional Supabase project (the anon/publishable key is public; enforce access with RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional HTTPS YouTube or Vimeo URL for the educational video embed.
VITE_EDUCATIONAL_VIDEO_URL=
